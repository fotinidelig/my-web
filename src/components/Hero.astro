---
import ProtectedImage from './ProtectedImage.astro';

/**
 * Avatar crop controls — tweak these to reframe the photo without editing CSS elsewhere.
 * - position: CSS object-position (horizontal% vertical%). Lower vertical % = bias toward the face.
 * - zoom: 1 = natural cover crop; >1 zooms in; <1 zooms out (may letterbox depending on frame).
 */
const avatar = {
  src: '/profile_avatar.jpg',
  position: '50% 60%',
  zoom: 1.01,
};
---
<section id="hero" class="w-full bg-accent-sand/5 text-center md:text-left">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-20 md:py-28">
    <div class="grid gap-10 items-center md:grid-cols-2 md:gap-8">
      <div class="order-2 md:order-1">
        <h1 class="text-4xl md:text-6xl font-bold leading-tight text-gray-900 dark:text-white">
          Fotini Deligiannaki
          <span class="block text-accent-rose dark:text-accent-rose mt-2 md:mt-3">Creative Engineer & Technologist</span>
        </h1>
        <p class="mt-4 text-lg opacity-80 text-gray-700 dark:text-gray-200 md:max-w-xl">
          Engineer and creator working at the intersection of science, technology, and visual design.
        </p>
        <div class="mt-6 flex gap-3 justify-center md:justify-start">
          <a href="#projects" class="px-4 py-2 rounded-md bg-accent-rose text-white shadow-md hover:shadow-lg dark:hover:shadow-lg hover:bg-opacity-90 dark:hover:bg-opacity-90 transition-all duration-300">View Projects</a>
          <a href="#contact" class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-100 shadow-md hover:shadow-lg dark:hover:shadow-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300">Contact</a>
        </div>
      </div>
      <div class="order-1 md:order-2 flex justify-center md:justify-end">
        <div class="relative h-44 w-36 sm:h-56 sm:w-44 md:h-[26rem] md:w-80">
          <div
            class="absolute inset-0 -translate-x-5 translate-y-5 rounded-2xl bg-accent-rose/40 dark:bg-accent-rose/40 shadow-2xl"
            aria-hidden="true"
          ></div>
          <div class="relative z-10 h-full w-full overflow-hidden rounded-2xl shadow-lg sm:h-56 sm:w-44 md:h-[26rem] md:w-80">
            <ProtectedImage
              src={avatar.src}
              alt="Fotini Deligiannaki"
              class="h-full w-full object-cover"
              style={`object-position: ${avatar.position}; transform: scale(${avatar.zoom}); transform-origin: center;`}
              watermark={false}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
